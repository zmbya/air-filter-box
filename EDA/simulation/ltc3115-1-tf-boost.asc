TEXT -80 -16 Left 2 !.ac dec 100 10 1meg
TEXT -80 -192 Left 2 !.param GBOOST=(29.7*VOUT**2)/VIN**2\n.param fZ = (1/(2*pi*Rc*Co))\n.param fRHPZ = ((R*(1-tLOW*f)**2*VIN**2)/(2*pi*L*VOUT**2))\n.param fo = (1/(2*pi))*sqrt((Rs+(R*VIN**2)/VOUT**2)/(L*Co*(R+Rc)))\n.param Q = (sqrt(L*Co*R*(Rs+(R*VIN**2)/VOUT**2))/(L+Co*Rs*R))
TEXT -360 -328 Left 2 !.param VOUT = 12\n.param VIN=5\n.param f = 1meg\n.param tLOW = 90n\n.param L = 10u\n.param Rl = 27m\n.param Co = 4.7u\n.param Rc = 4m\n.param Rs = Rl+300m\n.param R=24
